{
  "name": "@pungfe/element",
  "version": "0.9.5",
  "description": "Element Plus Components",
  "keywords": [
    "Element",
    "Element Plus",
    "vue"
  ],
  "homepage": "https://github.com/pungfen/element#readme",
  "bugs": {
    "url": "https://github.com/pungfen/element/issues"
  },
  "license": "MIT",
  "author": "pungfeng <fp94214@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pungfen/element.git"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./advance": {
      "types": "./dist/advance.d.ts",
      "import": "./dist/advance.js",
      "require": "./dist/advance.cjs"
    },
    "./basic": {
      "types": "./dist/basic.d.ts",
      "import": "./dist/basic.js",
      "require": "./dist/basic.cjs"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js",
      "require": "./dist/locales.cjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js",
      "require": "./dist/resolver.cjs"
    },
    "./style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm -C __play__ dev",
    "build": "vite build",
    "build:dev": "vite build --mode staging",
    "test": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "vue-tsc -p tsconfig.src.json --noEmit",
    "commit": "git-cz",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "element-plus": "catalog:",
    "sortablejs": "^1.15.7",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@eslint/json": "^2.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "catalog:",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "fast-glob": "^3.3.3",
    "happy-dom": "catalog:",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "unplugin-dts": "catalog:",
    "unplugin-vue": "^8.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-component-type-helpers": "catalog:",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "element-plus": "catalog:",
    "vue": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged",
    "commit-msg": "pnpm commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
